<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="ventana" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.reddonantes.controller.MainController">
   <left>
      <VBox prefWidth="210.0" spacing="4.0" styleClass="lateral" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="marca">
               <children>
                  <Region maxHeight="20.0" maxWidth="16.0" minHeight="20.0" minWidth="16.0" prefHeight="20.0" prefWidth="16.0" styleClass="gota" />
                  <Label styleClass="marca-nombre" text="Red de Donantes" />
               </children>
               <padding>
                  <Insets bottom="18.0" left="8.0" right="8.0" top="4.0" />
               </padding>
            </HBox>
            <Button fx:id="btnInicio" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarInicio" styleClass="nav" text="Inicio" />
            <Button fx:id="btnDonantes" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarDonantes" styleClass="nav" text="Donantes" />
            <Button fx:id="btnDonaciones" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarDonaciones" styleClass="nav" text="Donaciones" />
            <Button fx:id="btnInventario" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarInventario" styleClass="nav" text="Inventario" />
            <Button fx:id="btnSolicitudes" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarSolicitudes" styleClass="nav" text="Solicitudes" />
            <Button fx:id="btnCampanias" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarCampanias" styleClass="nav" text="Campañas" />
            <Button fx:id="btnHospitales" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarHospitales" styleClass="nav" text="Hospitales" />
            <Region VBox.vgrow="ALWAYS" />
            <Label styleClass="pie-lateral" text="Simulación académica. No sustituye el criterio médico." wrapText="true">
               <padding>
                  <Insets bottom="4.0" left="8.0" right="8.0" top="10.0" />
               </padding>
            </Label>
         </children>
         <padding>
            <Insets bottom="14.0" left="10.0" right="10.0" top="16.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <BorderPane fx:id="panelContenido" styleClass="contenido" BorderPane.alignment="CENTER">
         <top>
            <HBox alignment="CENTER_LEFT" styleClass="encabezado" BorderPane.alignment="CENTER">
               <children>
                  <VBox spacing="2.0">
                     <children>
                        <Label fx:id="lblTitulo" styleClass="titulo" text="Inicio" />
                        <Label fx:id="lblFecha" styleClass="subtitulo" text="Fecha" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="12.0" left="24.0" right="24.0" top="18.0" />
               </padding>
            </HBox>
         </top>
      </BorderPane>
   </center>
</BorderPane>
